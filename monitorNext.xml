<?xml version="1.0" encoding="utf-8"?>
<EnvironmentMonitor version="1" outputEffectiveXML="monitor.effective.xml">

  <DefaultEnvironment>
    <SystemMonitor timeout="2min" onIdle="sleep+1x" onDemand="sleepless" onSuspendTimeout="reboot+1x">

      <NetworkInterfaceBlock interface="{44ECA482-24F2-4362-99F8-88A17A450B45}" force="true" />

      <NetworkMonitor name="Ethernet" network="192.168.128.10/32" 
        autoDetect="MAC|IP|Router|SleepProxy" watchUDPPort="9"
        advertise="lazy" advertiseServices="true" handoff="SleepProxy|mandatory" handoffDuration="24h"
        sleepProxyDiscovery="eager" allowWakeOnLAN="MagicPacket" 
        demandSource="Host" demandParallel="2">

        <Service name="Apollo" port="47989" handoff="false" />
        <Service name="SSH" port="22" />

        <VirtualHost name="dragonfly" onIdle="suspend+1h">
          <Service name="SSH" port="22" />
        </VirtualHost>

        <VirtualHost name="gitlab" onIdle="suspend+30min">
          <Service name="SSH" port="22" />
          <Service name="HTTP" port="80" />

          <Service name="SMB" port="445">
            <HostFilterRule name="DRAGON" type="Must" /> <!-- only for backup -->
          </Service>

          <!-- <HTTPService name="HTTP"> TODO: Implementieren !!
            <Request name="runner" path="/api/v4/jobs" ignore="true" />
          </HTTPService> -->
        </VirtualHost>

        <VirtualHost name="jindujun">
          <Service name="TimeMachine" port="445" />
          <Service name="FileRun" port="80" />
        </VirtualHost>

        <!-- Test VMs -->

        <VirtualHost name="WIN10-TEST" onDemand="" onIdle="suspend" advertise="never">
          <Service name="RDP" port="3389" />
          <Service name="SMB" port="445" />
        </VirtualHost>

        <VirtualHost name="WIN11-TEST" onIdle="suspend" handoff="SleepProxy">
          <Service name="RDP" port="3389" />
        </VirtualHost>

        <!-- AI agents -->

        <VirtualHost name="mr-crabs" onIdle="suspend+30min" handoff="SleepProxy">
          <Service name="SSH" port="22" />
        </VirtualHost>

      </NetworkMonitor>

      <NetworkSessionMonitor watchPassive="true">
        <FilterRule clientName="jindujun" shareName="Vault" />
        <FilterRule clientName="test" shareName="moin" />
      </NetworkSessionMonitor>

      <SessionMonitor spawnMinions="true">

        <User name="TV" onIdle="logout+30min">
          <Process name="Browser" minCPU="1min">chrome|edge|firefox</Process>
          <Process name="Steam" minCPU="10%" watchChildren="true" onIdle="stop+30min" onSessionIdle="stop">steam</Process>
          <Process name="VLC" minCPU="0.5%">vlc</Process>
        </User>

        <User name="Ghost" onIdle="logout+2h" allowControlSleep="true" />

        <User name="Wizard">
          <Process name="VLC" minCPU="0.05%">vlc</Process>

          <Process name="Claude Code" minCPU="0.2%">claude</Process>
        </User>

        <User name="Kevin" />

        <Administrator allowControlSession="true" allowControlSleep="true" />

      </SessionMonitor>

      <ProcessMonitor>
        <Process name="VLC" minCPU="0.1%">C:\\Program Files\\VideoLAN</Process>
      </ProcessMonitor>

      <PowerRequestMonitor>
        <RequestFilterRule type="Must" name="Audio/Video">chrome|spotify|Medienelement-Energieanforderung|Audiostream</RequestFilterRule>
        <RequestFilterRule type="Must" name="Backup">CBBackupPlan</RequestFilterRule>
        <RequestFilterRule type="Must" name="Debugging">Microsoft Visual Studio Remote Debugger</RequestFilterRule>
      </PowerRequestMonitor>
    </SystemMonitor>
  </DefaultEnvironment>

  <Environment name="home" network="192.168.128.0/24">
    <DuoSessionMonitor onInstanceIdle="stop" onInstanceLogout="stop" 
      useFallback="false" usePolling="false">

      <Instance name="Kevin" onDemand="start" />

      <Instance name="Johannes" onDemand="start"
        preventIdleIfStreaming="false" minStreamTraffic="5MB/s">

        <Process name="Steam" minCPU="5%" minGPU="10%" watchChildren="true">steam</Process>

      </Instance>

      <Instance name="Test" onDemand="start" />

    </DuoSessionMonitor>
  </Environment>
</EnvironmentMonitor>
