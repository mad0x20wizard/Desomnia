<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>desomniad</AssemblyName>
    <RootNamespace>MadWizard.Desomnia.Daemon</RootNamespace>
    <LangVersion>preview</LangVersion>
	<RollForward>LatestMajor</RollForward>
	<!-- LibraryImport (source-generated P/Invoke marshalling) requires unsafe code -->
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Memory footprint tuning (see AOT analysis). Measure RSS before/after. -->
    <!-- Drops the ICU data mapping; safe for a daemon that does no culture-aware formatting. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Workstation, non-concurrent GC: avoids Server GC's per-core heap reservations. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Preserve all Desomnia types/members under trimming + NativeAOT (reflective activation & config binding). -->
    <TrimmerRootDescriptor Include="..\build\Desomnia.TrimmerRoots.xml" />
    <TrimmerRootDescriptor Include="..\build\Desomnia.TrimmerRoots.Daemon.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <PackageReference Include="Tmds.DBus.Generator" Version="0.94.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-Bus proxies are generated at compile time from introspection XML (AOT-safe, no Reflection.Emit). -->
    <AdditionalFiles Include="DBus\Protocol\org.freedesktop.login1.Manager.xml" Namespace="MadWizard.Desomnia.Daemon.DBus.Generated" DBusGeneratorMode="Proxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesomniaCore\DesomniaCore.csproj" />
    <ProjectReference Include="..\modules\NetworkMonitor\NetworkMonitor.csproj" />
    <ProjectReference Include="..\modules\PowerRequestMonitor\PowerRequestMonitor.csproj" />
    <ProjectReference Include="..\modules\ProcessMonitor\ProcessMonitor.csproj" />
  </ItemGroup>

  <!-- AOT: statically link plugins that are otherwise loaded dynamically (RegisterPluginModules is skipped). -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <ProjectReference Include="..\plugins\FirewallKnockOperator\FirewallKnockOperator.csproj" />
    <TrimmerRootAssembly Include="FirewallKnockOperator" />
    <ProjectReference Include="..\plugins\FRITZBoxRouter\FRITZBoxRouter.csproj" />
    <TrimmerRootAssembly Include="FRITZBoxRouter" />
  </ItemGroup>

  <!--
    Always-on build: cap the GC heap and decommit aggressively. Confirmed on the Pi to cut RssAnon
    (~7 MB) with the live heap at ~7 MB. 25165824 = 0x1800000 = 24 MiB. Tunable; raise or drop the
    hard limit if real load needs more head-room.
  -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="25165824" Trim="false" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" Trim="false" />
  </ItemGroup>

  <!--
    AOT publish: optimize for size to shrink the binary and its resident code pages (RssFile).
    All switches below are safe for a headless daemon (no debugger, no EventSource/ETW, no HTTP
    distributed-tracing).
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

</Project>
