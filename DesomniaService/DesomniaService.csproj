<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MadWizard.Desomnia.Service</RootNamespace>
    <ApplicationIcon>Properties\moon.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
	<RollForward>LatestMajor</RollForward>
	<LangVersion>preview</LangVersion>
	<!-- LibraryImport (source-generated P/Invoke marshalling) requires unsafe code -->
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Properties\moon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageReference Include="NLog.Targets.AtomicFile" Version="6.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve all Desomnia types/members under trimming + NativeAOT (reflective activation & config binding). -->
    <TrimmerRootDescriptor Include="..\build\Desomnia.TrimmerRoots.xml" />
    <TrimmerRootDescriptor Include="..\build\Desomnia.TrimmerRoots.Service.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesomniaCore\DesomniaCore.csproj" />
    <ProjectReference Include="..\modules\DisplayMonitor\DisplayMonitor.csproj" />
    <ProjectReference Include="..\modules\NetworkMonitor\NetworkMonitor.csproj" />
    <ProjectReference Include="..\modules\NetworkSessionMonitor\NetworkSessionMonitor.csproj" />
    <ProjectReference Include="..\modules\PowerRequestMonitor\PowerRequestMonitor.csproj" />
    <ProjectReference Include="..\modules\ProcessMonitor\ProcessMonitor.csproj" />
    <ProjectReference Include="..\modules\SessionMonitor\SessionMonitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Test\NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
