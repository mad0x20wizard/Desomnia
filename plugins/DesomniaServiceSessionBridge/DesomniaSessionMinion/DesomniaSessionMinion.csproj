<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DesomniaSessionMinion</RootNamespace>
    <StartupObject>MadWizard.Desomnia.Minion.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The GUI supports localization; an empty value retains all satellite languages. -->
    <SatelliteResourceLanguages />
    <ApplicationIcon>Minion.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <!-- Never bind against the throwing Menu/ContextMenu stubs .NET 10 re-added to System.Windows.Forms;
         the real implementation comes from the WinFormsLegacyControls fork (System.Windows.Forms.Legacy). -->
    <WarningsAsErrors>$(WarningsAsErrors);WFDEV006</WarningsAsErrors>
    <!-- WFO1000 (designer serialization config) does not apply to these runtime-only forms.
         WFO0003: DPI awareness stays in app.manifest (plus the explicit SetProcessDPIAware call)
         to preserve the exact .NET Framework DPI behavior. -->
    <NoWarn>$(NoWarn);WFO1000;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.1.3" />
    <PackageReference Include="ObjectListView.Repack.NET6Plus" Version="2.9.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesomniaPipe\DesomniaPipe.csproj" />
    <ProjectReference Include="..\..\..\libs\WinFormsLegacyControls\src\WinFormsLegacyControls\WinFormsLegacyControls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
